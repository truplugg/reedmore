{
  "name": "ridmore",
  "version": "1.0.0",
  "private": true,
  "description": "Ridmore — Ukrainian bookshop and gift platform for Germany and Ukraine",
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/api",
    "start": "npm run start --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:deploy": "npm run db:deploy --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:studio": "npm run db:studio --workspace apps/api",
    "db:reset": "npm run db:reset --workspace apps/api",
    "create:admin": "npm run create:admin --workspace apps/api",
    "test": "npm run test --workspace apps/api",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspace apps/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  }
}
