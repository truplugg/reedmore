# ---------- database ----------
DATABASE_URL="postgresql://ridmore:ridmore@localhost:5432/ridmore?schema=public"

# ---------- server ----------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public origin, used for links in email and for cookie security.
PUBLIC_URL="http://localhost:3000"

# ---------- secrets ----------
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-48-random-bytes-before-you-deploy-anything"

# ---------- media storage ----------
# "local" writes under STORAGE_LOCAL_DIR and needs nothing else.
# "s3" needs the four S3_* values; nothing else in the app changes.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage/media"
STORAGE_PUBLIC_PATH="/media"
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- email ----------
# "console" prints the message to the log — password reset works without an SMTP account.
MAIL_DRIVER=console
MAIL_FROM="Ridmore <no-reply@ridmore.shop>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---------- payments (not wired yet; see docs/ARCHITECTURE.md) ----------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
